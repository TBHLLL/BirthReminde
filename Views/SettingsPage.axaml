<ci:SettingsPageBase x:Class="BirthReminde.Views.SettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BirthReminde.Views"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      d:DataContext="{d:DesignInstance local:SettingsPage}">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <ci:IconText Glyph="&#xE8AD;" Text="常规设置" Margin="0 0 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8AD;}" 
                                       Header="生日管理"
                                       Description="添加、编辑和删除生日信息"
                                       IsExpanded="True">
                <StackPanel Margin="0 8 0 0">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8" Spacing="8">
                        <TextBox x:Name="NameTextBox"
                                  Watermark="姓名"
                                  Width="150"/>
                        <DatePicker x:Name="DatePicker"
                                    MonthVisible="True"
                                    DayVisible="True"
                                    Width="300"/>
                        <Button Content="添加"
                                Click="AddBirthday_Click"
                                Width="80"/>
                    </StackPanel>
                    <DataGrid x:Name="BirthdaysGrid"
                              ItemsSource="{Binding BirthdayRows}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowBackground="Transparent"
                              Height="250"
                              DoubleTapped="BirthdaysGrid_OnDoubleTapped"
                              Background="{DynamicResource MaterialDesignPaper}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="全选" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Click="RowCheckBox_Click"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="姓名"
                                                Binding="{Binding Item.Name}"
                                                Width="120"/>
                            <DataGridTextColumn Header="生日"
                                                Binding="{Binding Item.Date, StringFormat='yyyy-MM-dd'}"
                                                Width="120"/>
                            <DataGridTextColumn Header="备注"
                                                Binding="{Binding Item.Notes}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="操作" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="编辑"
                                                    Click="EditBirthday_Click"
                                                    Width="60"/>
                                            <Button Content="删除"
                                                    Click="RemoveBirthday_Click"
                                                    Width="60"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0" Spacing="8">
                        <CheckBox x:Name="SelectAllCheckBox"
                                  Content="全选"
                                  IsThreeState="True"
                                  Click="SelectAllCheckBox_Click"
                                  VerticalAlignment="Center"/>
                        <Button x:Name="DeleteSelectedButton"
                                Content="删除选中"
                                Click="RemoveSelected_Click"
                                Width="100"/>
                        <TextBlock Text="勾选行后可批量删除，双击行编辑" 
                                   Opacity="0.6"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsExpander> <!-- 设置页面的常规设置 -->

            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="&#xe064;" Text="文件设置" Margin="0 0 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xe881;}" 
                                       Header="文件导入"
                                       Description="从 CSV 或 Excel 文件批量导入生日信息（格式：姓名,日期,备注）"
                                       IsExpanded="False">
                <StackPanel Margin="0 8 0 0" Spacing="8">
                    <TextBlock Text="文件格式：姓名,日期(如 2026/8/5、2026-08-05、2026年8月5日),备注（可选）。支持 .csv 与 .xlsx。"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="CsvFilePathTextBox"
                                 Watermark="文件路径"
                                 Width="350"
                                 IsReadOnly="True" />
                        <Button Content="选择文件"
                                Click="SelectCsvFile_Click"
                                Width="80" />
                        <Button Content="导入"
                                Click="ImportCsv_Click"
                                Width="80" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xe881;}" 
                                       Header="数据导出"
                                       Description="把生日列表导出为 CSV 或 Excel 文件"
                                       IsExpanded="False">
                <StackPanel Margin="0 8 0 0" Spacing="8">
                    <TextBlock Text="导出当前全部生日（姓名、日期、备注），CSV 可直接再次导入。"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出 CSV"
                                Click="ExportCsv_Click"
                                Width="100" />
                        <Button Content="导出 Excel"
                                Click="ExportExcel_Click"
                                Width="100" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsExpander>
            
            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="&#xe025;" Text="提醒设置" Margin="0 0 0 4" />
            <controls:SettingsExpander Header="提醒设置"
                                       IconSource="{ci:FluentIconSource &#xe025;}"
                                       Description="配置生日提醒的相关选项"
                                       IsExpanded="False">
                <controls:SettingsExpanderItem Content="生日提醒范围(天)">
                    <controls:SettingsExpanderItem.Footer>
                        <controls:NumberBox VerticalAlignment="Center"
                                            MinWidth="147"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding Settings.RemideRange}"/>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
