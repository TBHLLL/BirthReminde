<ci:ComponentBase x:TypeArguments="models:BirthRemindeComponentSettings"
                  x:Class="BirthReminde.Views.Components.BirthdayTodayComponentSettingsControl"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:models="clr-namespace:BirthReminde.Models"
                  xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  x:DataType="models:BirthRemindeComponentSettings">
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="4">
            <!-- <ToggleSwitch Content="显示生日者姓名" -->
            <!--               IsChecked="{Binding ShowNames}" /> -->
            <!-- <StackPanel Orientation="Horizontal" Spacing="8"> -->
            <!--     <TextBlock Text="最多显示姓名数" VerticalAlignment="Center" /> -->
            <!--     <NumericUpDown Minimum="1" -->
            <!--                    Maximum="20" -->
            <!--                    Increment="1" -->
            <!--                    Width="120" -->
            <!--                    Value="{Binding MaxNameCount}" /> -->
            <!-- </StackPanel> -->
            <!-- <TextBlock Text="字体大小与颜色请在编辑模式中选中本组件，通过「高级设置」调整。" -->
            <!--            Opacity="0.7" -->
            <!--            TextWrapping="Wrap" /> -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE8AD;}" 
                                            Header="显示设置"
                                            Description="自定义生日提醒的显示样式"
                                            IsExpanded="True">
                <controls:FASettingsExpanderItem Content="显示年龄">
                    <controls:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding IsShowPersonAge}"/>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="循环切换">
                        <controls:FASettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding IsCycleEnabled}"/>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="切换间隔(秒)">
                        <controls:FASettingsExpanderItem.Footer>
                            <controls:FANumberBox VerticalAlignment="Center"
                                                 MinWidth="147"
                                                 Minimum="0.1"
                                                 SpinButtonPlacementMode="Inline"
                                                 Value="{Binding CycleIntervalSeconds}"/>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="过渡动画">
                        <controls:FASettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding IsAnimationEnabled}"/>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
    
</ci:ComponentBase>