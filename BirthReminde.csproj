<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <CreateCipx>true</CreateCipx>
        <!-- Avalonia 12 默认开启编译绑定（x:DataType + 具体类型 FindAncestor），与宿主/SystemTools 一致 -->
    </PropertyGroup>

    <PropertyGroup>
        <ClassIslandPluginSdkVersion>1.7.106.2-dev-v2</ClassIslandPluginSdkVersion>
    </PropertyGroup>

    <ItemGroup>
        <!--
          关键：所有宿主已提供的程序集（ClassIsland.Core / FluentAvalonia / Avalonia / DataGrid）
          必须用 ExcludeAssets=runtime; native 排除，确保插件目录不复制这些 DLL、deps.json
          不列出它们——插件 ALC 全部回落宿主 Default ALC。
          否则：1) 插件加载自己的 ClassIsland.Core 副本导致 Plugin 入口类型身份不一致而被跳过；
               2) 插件自带 Avalonia 与宿主并存（双类型身份）会让 JIT 编译 XAML populate 时
                  MissingFieldException: FANumberBox.ValueProperty。
        -->
        <PackageReference Include="Avalonia" Version="12.1.1">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="MiniExcel" Version="2.0.0-preview.4" />
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\Components\birthreminersettings.axaml.cs">
        <DependentUpon>birthreminersettings.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Components\birthreminder.axaml.cs">
        <DependentUpon>birthreminder.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <!-- MiniExcel 是插件独有依赖（宿主 ClassIsland 不提供），需随插件分发 -->
    <Target Name="CopyMiniExcelToOutput" AfterTargets="Build" BeforeTargets="CreateCipx">
        <ItemGroup>
            <_MiniExcelLib Include="$(NuGetPackageRoot)miniexcel\*\lib\net10.0\MiniExcel.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(_MiniExcelLib)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    </Target>

</Project>
