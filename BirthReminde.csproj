<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <CreateCipx>true</CreateCipx>
        <!-- 与宿主 ClassIsland 保持一致：默认关闭编译绑定（插件 XAML 使用反射绑定） -->
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup>
        <ClassIslandPluginSdkVersion>1.7.106.2-dev-v2</ClassIslandPluginSdkVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="MiniExcel" Version="2.0.0-preview.4" />
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\Components\birthreminersettings.axaml.cs">
        <DependentUpon>birthreminersettings.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Components\birthreminder.axaml.cs">
        <DependentUpon>birthreminder.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <!-- MiniExcel 是插件独有依赖（宿主 ClassIsland 不提供），需随插件分发 -->
    <Target Name="CopyMiniExcelToOutput" AfterTargets="Build" BeforeTargets="CreateCipx">
        <ItemGroup>
            <_MiniExcelLib Include="$(NuGetPackageRoot)miniexcel\*\lib\net10.0\MiniExcel.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(_MiniExcelLib)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    </Target>

</Project>
