<ci:SettingsPageBase x:Class="BirthReminde.Views.SettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BirthReminde.Views"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      d:DataContext="{d:DesignInstance local:SettingsPage}">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <ci:IconText Glyph="&#xE8AD;" Text="常规设置" Margin="0 0 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8AD;}" 
                                       Header="生日管理"
                                       Description="添加、编辑和删除生日信息"
                                       IsExpanded="True">
                <StackPanel Margin="0 8 0 0">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8" Spacing="8">
                        <TextBox x:Name="NameTextBox"
                                  Watermark="姓名"
                                  Width="150"/>
                        <DatePicker x:Name="DatePicker"
                                    MonthVisible="True"
                                    DayVisible="True"
                                    YearVisible="False"
                                    Width="150"/>
                        <Button Content="添加"
                                Click="AddBirthday_Click"
                                Width="80"/>
                    </StackPanel>
                    <ListBox x:Name="BirthdaysListBox"
                             ItemsSource="{Binding Settings.Birthdays}"
                             Height="250">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{Binding Name}"
                                               Width="120"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Date, StringFormat='yyyy-MM-dd'}"
                                               Width="120"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Notes}"
                                               Width="150"
                                               VerticalAlignment="Center"
                                               Classes="l-instructive"/>
                                    <Button Content="删除"
                                            Click="RemoveBirthday_Click"
                                            Width="60"
                                            Margin="8 0 0 0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </controls:SettingsExpander> <!-- 设置页面的常规设置 -->

            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="&#xE4C4;" Text="文件设置" Margin="0 0 0 4" />
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}" 
                                       Header="CSV导入"
                                       Description="从CSV文件批量导入生日信息（格式：姓名,日期,备注）"
                                       IsExpanded="False">
                <StackPanel Margin="0 8 0 0" Spacing="8">
                    <TextBlock Text="CSV文件格式：姓名,日期(如 2026/8/5、2026-08-05、2026年8月5日),备注（可选）"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="CsvFilePathTextBox"
                                 Watermark="CSV文件路径"
                                 Width="350"
                                 IsReadOnly="True" />
                        <Button Content="选择文件"
                                Click="SelectCsvFile_Click"
                                Width="80" />
                        <Button Content="导入"
                                Click="ImportCsv_Click"
                                Width="80" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsExpander>
            
            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="&#xE015;" Text="提醒设置" Margin="0 0 0 4" />
            <controls:SettingsExpander Header="提醒设置"
                                       Description="配置生日提醒的相关选项"
                                       IsExpanded="False">
                <controls:SettingsExpanderItem Content="生日提醒范围(天)">
                    <controls:SettingsExpanderItem.Footer>
                        <controls:NumberBox VerticalAlignment="Center"
                                            MinWidth="147"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding Settings.RemideRange}"/>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
